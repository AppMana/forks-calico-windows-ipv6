# FIXME: Use WINDOWS_HPC_VERSION and image instead of nanoserver and WINDOWS_VERSIONS when containerd v1.6 is EOL'd
# ARG WINDOWS_HPC_VERSION
ARG WINDOWS_VERSION

# === hookbuilder ============================================================
# Linux multi-stage builder that cross-compiles the hns-ipv6-hook DLL with
# mingw-w64. Runs on the buildx host (Linux/amd64) regardless of the final
# image platform. Requires `--build-context hooksrc=cni-plugin/cmd/hns-ipv6-hook`
# at build time so the C source is reachable from this Dockerfile (which is
# rooted at node/).
# ----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM ubuntu:24.04 AS hookbuilder
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        gcc-mingw-w64-x86-64-win32 \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY --from=hooksrc hook.c /src/
RUN mkdir -p /out && \
    x86_64-w64-mingw32-gcc -O2 -Wall -shared \
        -o /out/hns-ipv6-hook.dll /src/hook.c \
        -lws2_32 -liphlpapi -static-libgcc

# === final image ============================================================
#FROM mcr.microsoft.com/oss/kubernetes/windows-host-process-containers-base-image:${WINDOWS_HPC_VERSION}
FROM mcr.microsoft.com/windows/nanoserver:${WINDOWS_VERSION}

ARG GIT_VERSION=unknown

# Required labels for certification
LABEL org.opencontainers.image.description="Calico node handles networking and policy for Calico"
LABEL org.opencontainers.image.authors="maintainers@tigera.io"
LABEL org.opencontainers.image.source="https://github.com/projectcalico/calico"
LABEL org.opencontainers.image.title="Calico node"
LABEL org.opencontainers.image.vendor="Project Calico"
LABEL org.opencontainers.image.version="${GIT_VERSION}"
LABEL org.opencontainers.image.licenses="Apache-2.0"

COPY dist/LICENSE /licenses/LICENSE

COPY dist/bin/calico-node.exe /CalicoWindows/calico-node.exe
COPY dist/bin/calico.exe /opt/cni/bin/calico.exe
COPY dist/bin/calico-ipam.exe /opt/cni/bin/calico-ipam.exe

# hns-ipv6 hook: injector (Go cross-compiled into dist/bin) + DLL (built
# from C source by the hookbuilder stage above). Optional at runtime —
# node-service.ps1 only invokes them when CALICO_HNS_IPV6_HOOK=true (or
# CALICO_DESIRED_HNS_MGMT_IPV6 is set without explicit ="false"). When
# unused, the legacy Strip-NonClusterIPv6 path runs instead. See
# cni-plugin/cmd/hns-ipv6-hook/README.md for the design.
COPY dist/bin/hns-ipv6-injector.exe /CalicoWindows/hns-ipv6-injector.exe
COPY --from=hookbuilder /out/hns-ipv6-hook.dll /CalicoWindows/hns-ipv6-hook.dll

COPY windows-packaging/CalicoWindows/felix/felix-service.ps1 /CalicoWindows/felix-service.ps1
COPY windows-packaging/CalicoWindows/node/node-service.ps1 /CalicoWindows/node-service.ps1
COPY windows-packaging/CalicoWindows/confd /CalicoWindows/confd
COPY windows-packaging/CalicoWindows/config-hpc.ps1 /CalicoWindows/config.ps1
COPY windows-packaging/CalicoWindows/libs/calico/calico.psm1 /CalicoWindows/libs/calico/calico.psm1
COPY windows-packaging/CalicoWindows/libs/hns/hns.psm1 /CalicoWindows/libs/hns/hns.psm1
# cni.conf.template is read by Write-CNIConfig at every container start
# (node-service.ps1) to regenerate /etc/cni/net.d/10-calico.conf, so
# changes to ConfigMap-driven env vars propagate without a host reinstall.
COPY windows-packaging/CalicoWindows/cni.conf.template /CalicoWindows/cni.conf.template
COPY windows-packaging/nssm.exe /nssm.exe
COPY windows-packaging/CalicoWindows/uninstall-calico-hpc.ps1 /uninstall-calico.ps1

ENV PATH="$PATH;C:\CalicoWindows;C:\Windows\System32;C:\Windows;C:\Windows\System32\WindowsPowerShell\v1.0;C:\Program Files\PowerShell"
WORKDIR /CalicoWindows
# The nanoserver image does not have powershell but this works because
# this container will be running on the host.
ENTRYPOINT ["powershell"]
