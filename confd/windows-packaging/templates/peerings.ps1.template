{{- $config := getBGPConfig 4 . -}}

{{- $node_ip_key := printf "/host/%s/ip_addr_v4" $config.NodeName}}
{{- $node_ip := getv $node_ip_key}}
$local_ip = "{{$node_ip}}"

{{- $node_ipv6_key := printf "/host/%s/ip_addr_v6" $config.NodeName}}
{{- $node_ipv6 := ""}}
{{- if exists $node_ipv6_key}}{{$node_ipv6 = getv $node_ipv6_key}}{{end}}
$local_ipv6 = "{{$node_ipv6}}"

{{- $bgp_id := $config.RouterID}}
$bgp_id = "{{if ne "" ($bgp_id)}}{{$bgp_id}}{{else}}{{$node_ip}}{{end}}"

{{- $node_as_key := printf "/host/%s/as_num" $config.NodeName}}
$local_asn = {{if exists $node_as_key}}{{getv $node_as_key}}{{else}}{{getv "/global/as_num"}}{{end}}

$peerings =
{{- if eq "" ($node_ip)}}
    # IPv4 is disabled on this node.
{{- else}}
    # IPv4 is enabled on this node.

    # ------------- Node-to-node mesh -------------
    {{- if (json (getv "/global/node_mesh")).enabled}}
        {{- range $host := lsdir "/host"}}
            {{- $onode_as_key := printf "/host/%s/as_num" .}}
            {{- $onode_ip_key := printf "/host/%s/ip_addr_v4" .}}
    	{{- if exists $onode_ip_key}}
                {{- $onode_ip := getv $onode_ip_key}}
                {{- $nums := split $onode_ip "."}}{{$id := join $nums "_"}}
    # For peer {{$onode_ip_key}}
                {{- if eq $onode_ip ($node_ip) }}
    # Skipping ourselves ({{$node_ip}})
                {{- else if ne "" $onode_ip}}
    @{ Name = "Mesh_{{$id}}"; IP = "{{$onode_ip}}"; AS = {{if exists $onode_as_key}}{{getv $onode_as_key}}{{else}}{{getv "/global/as_num"}}{{end}} },
                {{- end}}
            {{- end}}
        {{- end}}
        # ----- IPv6 mesh peers (one per host with an ip_addr_v6) -----
        # RRAS won't bind to IPv6 TCP 179 unless at least one IPv6 BGP peer
        # exists. Linux Bird's IPv6 mesh to this node uses passive=on, so we
        # MUST initiate from RRAS — Add-BgpPeer with IPv6 LocalIPAddress /
        # PeerIPAddress does that.
        {{- if ne "" $node_ipv6}}
            {{- range $host := lsdir "/host"}}
                {{- $onode_as_key := printf "/host/%s/as_num" .}}
                {{- $onode_ipv6_key := printf "/host/%s/ip_addr_v6" .}}
                {{- if exists $onode_ipv6_key}}
                    {{- $onode_ipv6 := getv $onode_ipv6_key}}
                    {{- $id6 := replace (replace $onode_ipv6 ":" "_" -1) "." "_" -1}}
    # For IPv6 peer {{$onode_ipv6_key}}
                    {{- if eq $onode_ipv6 ($node_ipv6) }}
    # Skipping ourselves ({{$node_ipv6}})
                    {{- else if ne "" $onode_ipv6}}
    @{ Name = "Mesh6_{{$id6}}"; IP = "{{$onode_ipv6}}"; LocalIP = "{{$node_ipv6}}"; AS = {{if exists $onode_as_key}}{{getv $onode_as_key}}{{else}}{{getv "/global/as_num"}}{{end}} },
                    {{- end}}
                {{- end}}
            {{- end}}
        {{- end}}
    {{- else}}
    # Node-to-node mesh disabled
    {{- end}}

    # ------------- Global peers -------------
    {{- if ls "/global/peer_v4"}}
        {{- range gets "/global/peer_v4/*"}}
            {{- $data := json .Value}}
            {{- $nums := split $data.ip "."}}
            {{- $id := join $nums "_"}}
    # For peer {{.Key}}
            {{- if eq $data.ip ($node_ip) }}
    # Skipping ourselves ({{$node_ip}})
            {{- else}}
    @{ Name = "Global_{{$id}}"; IP = "{{$data.ip}}"; AS = {{$data.as_num}}; KeepOriginalNextHop = {{if $data.keep_next_hop}}$true{{else}}$false{{end}} },
            {{- end}}
        {{- end}}
    {{- else}}
    # No global peers configured.
    {{- end}}

    # ------------- Node-specific peers -------------
    {{- $node_peers_key := printf "/host/%s/peer_v4" $config.NodeName}}
    {{- if ls $node_peers_key}}
        {{- range gets (printf "%s/*" $node_peers_key)}}
            {{- $data := json .Value}}
            {{- $nums := split $data.ip "."}}
            {{- $id := join $nums "_"}}
    # For peer {{.Key}}
            {{- if eq $data.ip ($node_ip) }}
    # Skipping ourselves ({{$node_ip}})
            {{- else}}
    @{ Name = "Node_{{$id}}"; IP = "{{$data.ip}}"; AS = {{$data.as_num}}; KeepOriginalNextHop = {{if $data.keep_next_hop}}$true{{else}}$false{{end}} },
            {{- end}}
        {{- end}}
    {{- else}}
    # No node-specific peers configured.
    {{- end}}
{{- end}}
    @{}
